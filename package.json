{
  "name": "ui",
  "devDependencies": {
    "@biomejs/biome": "^2.2.3",
    "@changesets/cli": "^2.29.6",
    "@total-typescript/tsconfig": "^1.0.4",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "license": "MIT",
  "packageManager": "bun@1.2.0",
  "private": true,
  "scripts": {
    "check": "biome check .",
    "dev": "turbo run dev",
    "deploy": "turbo run deploy --filter=playground",
    "build": "turbo run build",
    "fix": "biome check . --write",
    "format": "biome format . --write",
    "release": "turbo run build --filter=orphos && changeset publish"
  },
  "sideEffects": false,
  "trustedDependencies": [
    "@biomejs/biome",
    "@tailwindcss/oxide",
    "core-js",
    "esbuild",
    "sharp",
    "workerd"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ]
}

{
  "name": "ui",
  "license": "MIT",
  "dependencies": {},
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "scripts": {
    "check": "biome check .",
    "dev": "turbo run dev",
    "deploy": "turbo run deploy --filter=@theanalog/playground",
    "build": "turbo run build",
    "fix": "biome check . --write",
    "format": "biome format . --write",
    "release": "turbo run build --filter=@theanalog/orphos && changeset publish"
  },
  "sideEffects": false,
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.12",
    "@total-typescript/tsconfig": "^1.0.4",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3"
  },
  "workspaces": ["packages/*"],
  "packageManager": "bun@1.2",
  "trustedDependencies": ["@biomejs/biome", "core-js", "esbuild", "workerd"]
}

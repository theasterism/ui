{
  "name": "ui",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.29.2",
    "@total-typescript/tsconfig": "^1.0.4",
    "turbo": "^2.5.2",
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "packageManager": "bun@1.2.0",
  "private": true,
  "scripts": {
    "check": "biome check .",
    "dev": "turbo run dev",
    "deploy": "turbo run deploy --filter=@theanalog/playground",
    "build": "turbo run build",
    "fix": "biome check . --write",
    "format": "biome format . --write",
    "release": "turbo run build --filter=@theanalog/orphos && changeset publish"
  },
  "sideEffects": false,
  "trustedDependencies": [
    "@biomejs/biome",
    "core-js",
    "esbuild",
    "sharp",
    "workerd"
  ],
  "type": "module",
  "workspaces": ["packages/*"]
}
